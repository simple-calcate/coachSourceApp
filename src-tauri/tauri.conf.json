{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoachSource",
  "version": "0.1.0",
  "identifier": "com.jx235.coachsource",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "CoachSource 数据采集",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
